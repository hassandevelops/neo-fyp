graph TB
    subgraph DEVICE["📱 Android Device - API 26+ - Node"]
        direction TB

        UI["Presentation Layer\n(Jetpack Compose UI)"]

        BT["Bluetooth Networking Module\n(BluetoothService & RFCOMM)\n+ ImageChunker 4KB"]

        SEC["Security Layer\n(CryptoManager)\nEd25519 + RateLimiter"]

        SYNC["Sync Layer\nGossipProtocol · SyncManager\nAckManager · ConflictResolver"]

        subgraph DATA["Expanded Data Module - Room Database"]
            REPOS["Repositories: Posts | Devices | BlockedUsers | Comments | Reactions"]
            MGMT["Data Management: Cleanup & Export Features"]
        end

        KS["EncryptedSharedPreferences\n(MasterKey / AES256_GCM)"]
    end

    P2P["P2P Link - Bluetooth RFCOMM\n4KB Media Chunks & Social Signals"]

    UI --> BT
    UI --> DATA
    BT -->|"Verify"| SEC
    BT --> SYNC
    SYNC -->|"Sync"| DATA
    SEC --> KS
    KS --> DATA
    BT <--> P2P

    linkStyle default stroke:#ffffff,stroke-width:2px

    style DEVICE fill:#0d1117,stroke:#58a6ff,stroke-width:2px,color:#c9d1d9
    style UI fill:#1a2744,stroke:#1f6feb,stroke-width:1px,color:#c9d1d9
    style BT fill:#1a2744,stroke:#4361ee,stroke-width:1px,color:#c9d1d9
    style SEC fill:#2d1b22,stroke:#f85149,stroke-width:1px,color:#c9d1d9
    style SYNC fill:#132713,stroke:#3fb950,stroke-width:1px,color:#c9d1d9
    style DATA fill:#0d1f1f,stroke:#39d2c0,stroke-width:1px,color:#c9d1d9
    style REPOS fill:#0d1f1f,stroke:#39d2c0,stroke-width:0px,color:#c9d1d9
    style MGMT fill:#163030,stroke:#39d2c0,stroke-width:1px,color:#c9d1d9
    style KS fill:#1c0d1f,stroke:#bc8cff,stroke-width:1px,color:#c9d1d9
    style P2P fill:#21262d,stroke:#8b949e,stroke-width:1px,color:#c9d1d9
