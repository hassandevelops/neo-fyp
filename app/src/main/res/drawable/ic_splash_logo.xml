<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 
      Add padding to ensure the square logo fits inside the circular splash mask.
      Android 12+ masks the icon to a circle. 
      Padding needed: ~15-20% on each side to fit a square in that circle.
    -->
    <item
        android:top="16dp"
        android:bottom="16dp"
        android:left="16dp"
        android:right="16dp"
        android:gravity="center">
        <bitmap
            android:src="@drawable/logo"
            android:gravity="center" />
    </item>
</layer-list>
